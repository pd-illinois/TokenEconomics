{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokeneconomics.local/contracts/route-govern-candidate.v1.schema.json",
  "title": "Route Govern Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "schema_version",
    "created_at",
    "report_id",
    "plan_id",
    "receipt_id",
    "receipt_schema_version",
    "receipt_hash",
    "route_id",
    "meter_stack",
    "capability_profile",
    "candidate_controls",
    "route_assumptions",
    "constraint_inputs",
    "readiness",
    "hybrid",
    "token_subforecast",
    "content_hash"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "route-govern-candidate.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "report_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_schema_version": {"type": "string", "minLength": 1},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_id": {"type": "string", "minLength": 1},
    "meter_stack": {"type": "object"},
    "capability_profile": {"type": "object"},
    "candidate_controls": {"type": "object"},
    "route_assumptions": {"type": "object"},
    "constraint_inputs": {"type": "object"},
    "readiness": {"type": "object"},
    "hybrid": {"type": ["object", "null"]},
    "token_subforecast": {"type": ["object", "null"]},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
