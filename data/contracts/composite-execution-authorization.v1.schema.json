{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokeneconomics.dev/contracts/composite-execution-authorization.v1.schema.json",
  "title": "TokenEconomics composite route execution authorization",
  "$comment": "Authority matching, freshness, exact Azure policy binding, and billable preflight invariants are enforced by costgov.route_execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "execution_mode",
    "outcome",
    "evidence_label",
    "route_id",
    "capability_profile_version",
    "capability_profile_hash",
    "readiness_hash",
    "govern_decision_id",
    "govern_decision_hash",
    "plan_receipt_id",
    "plan_receipt_hash",
    "candidate_id",
    "candidate_version",
    "candidate_hash",
    "task_id",
    "trajectory_id",
    "segment_id",
    "segment_version",
    "policy",
    "bindings",
    "authority_evidence",
    "authorized_legs",
    "blocked_reasons",
    "preflight_at",
    "billable_execution_permitted"
  ],
  "properties": {
    "schema_version": {"const": "composite-execution-authorization.v1"},
    "authorization_id": {"$ref": "#/$defs/nonEmpty"},
    "execution_mode": {"enum": ["billable", "simulation"]},
    "outcome": {
      "enum": [
        "authorized",
        "externally_authorized",
        "simulation_authorized",
        "blocked"
      ]
    },
    "evidence_label": {
      "enum": ["measured", "simulated", "modeled", "blocked"]
    },
    "route_id": {"$ref": "#/$defs/nonEmpty"},
    "capability_profile_version": {"$ref": "#/$defs/nonEmpty"},
    "capability_profile_hash": {"$ref": "#/$defs/sha256"},
    "readiness_hash": {"$ref": "#/$defs/sha256"},
    "govern_decision_id": {"$ref": "#/$defs/nonEmpty"},
    "govern_decision_hash": {"$ref": "#/$defs/sha256"},
    "plan_receipt_id": {"$ref": "#/$defs/nonEmpty"},
    "plan_receipt_hash": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/nonEmpty"},
    "candidate_version": {"$ref": "#/$defs/nonEmpty"},
    "candidate_hash": {"$ref": "#/$defs/sha256"},
    "task_id": {"$ref": "#/$defs/nonEmpty"},
    "trajectory_id": {"$ref": "#/$defs/nonEmpty"},
    "segment_id": {"$ref": "#/$defs/nonEmpty"},
    "segment_version": {"$ref": "#/$defs/nonEmpty"},
    "policy": {
      "oneOf": [
        {"$ref": "#/$defs/policy"},
        {"type": "null"}
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/binding"}
    },
    "authority_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/authorityEvidence"}
    },
    "authorized_legs": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmpty"},
      "uniqueItems": true
    },
    "blocked_reasons": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "preflight_at": {"$ref": "#/$defs/utcTimestamp"},
    "billable_execution_permitted": {"type": "boolean"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+]00:00)$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "content_hash", "source", "label", "etag"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/nonEmpty"},
        "version": {"$ref": "#/$defs/nonEmpty"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "source": {"const": "azure_app_configuration"},
        "label": {"$ref": "#/$defs/nonEmpty"},
        "etag": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "control_kind",
        "target_leg",
        "authority",
        "capability",
        "enforcement_scope",
        "outcome",
        "authority_evidence_hash",
        "tokengov_enforcement_event",
        "reason"
      ],
      "properties": {
        "control_id": {"$ref": "#/$defs/nonEmpty"},
        "control_kind": {"$ref": "#/$defs/nonEmpty"},
        "target_leg": {"$ref": "#/$defs/nonEmpty"},
        "authority": {"$ref": "#/$defs/nonEmpty"},
        "capability": {"$ref": "#/$defs/nonEmpty"},
        "enforcement_scope": {
          "enum": [
            "runtime_enforced",
            "control_plane_enforced",
            "product_admin_enforced",
            "design_time_enforced",
            "external_requirement",
            "advisory",
            "correlation_only"
          ]
        },
        "outcome": {
          "enum": [
            "runtime_bound",
            "control_plane_bound",
            "product_admin_verified",
            "design_time_verified",
            "external_requirement_verified",
            "advisory_boundary",
            "correlation_boundary",
            "blocked"
          ]
        },
        "authority_evidence_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "tokengov_enforcement_event": {"type": "boolean"},
        "reason": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "authorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "authority",
        "state",
        "evidence_label",
        "evidence_id",
        "evidence_revision",
        "content_hash",
        "observed_at",
        "valid_until",
        "reason"
      ],
      "properties": {
        "control_id": {"$ref": "#/$defs/nonEmpty"},
        "authority": {"$ref": "#/$defs/nonEmpty"},
        "state": {"enum": ["satisfied", "failed", "unavailable"]},
        "evidence_label": {
          "enum": ["measured", "simulated", "modeled", "blocked"]
        },
        "evidence_id": {"$ref": "#/$defs/nonEmpty"},
        "evidence_revision": {"$ref": "#/$defs/nonEmpty"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "observed_at": {"$ref": "#/$defs/utcTimestamp"},
        "valid_until": {"$ref": "#/$defs/utcTimestamp"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
