{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokeneconomics:rag-qna-dataset:v1",
  "title": "Proposed five-book Q&A pilot, never human-reviewed acceptance proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "revision", "segment_revision", "family_revision", "content_hash", "evidence_status", "human_review_status", "operational_admission", "heldout_scored_proof", "notes", "sources", "cases"],
  "properties": {
    "schema_version": {"const": "rag-qna-dataset.v1"},
    "dataset_id": {"$ref": "#/$defs/nonempty"},
    "revision": {"$ref": "#/$defs/nonempty"},
    "segment_revision": {"$ref": "#/$defs/nonempty"},
    "family_revision": {"$ref": "#/$defs/nonempty"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "evidence_status": {"const": "proposed"},
    "human_review_status": {"const": "pending"},
    "operational_admission": {"const": false},
    "heldout_scored_proof": {"const": false},
    "notes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "file", "title", "sha256"],
        "properties": {
          "source_id": {"$ref": "#/$defs/nonempty"},
          "file": {"type": "string", "pattern": "^pg[0-9]+\\.txt$"},
          "title": {"$ref": "#/$defs/nonempty"},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "family_id", "segment_id", "partition", "question", "expected_answer", "rubric", "source_locators", "answer_behavior", "expected_answer_status", "human_review_status"],
        "properties": {
          "case_id": {"$ref": "#/$defs/nonempty"},
          "family_id": {"$ref": "#/$defs/nonempty"},
          "segment_id": {"enum": ["factual", "synthesis", "cross-book", "ambiguous", "unanswerable"]},
          "partition": {"enum": ["development", "holdout"]},
          "question": {"$ref": "#/$defs/nonempty"},
          "expected_answer": {"$ref": "#/$defs/nonempty"},
          "rubric": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
          "source_locators": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "locator"],
              "properties": {"source_id": {"$ref": "#/$defs/nonempty"}, "locator": {"$ref": "#/$defs/nonempty"}}
            }
          },
          "answer_behavior": {"enum": ["answer", "clarify", "abstain"]},
          "expected_answer_status": {"const": "proposed"},
          "human_review_status": {"const": "pending"}
        }
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
