{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokeneconomics.local/contracts/evaluation-decision-state.v1.schema.json",
  "title": "TokenEconomics evaluation decision state event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "recorded_at",
    "candidate_id",
    "candidate_version",
    "candidate_content_hash",
    "segment_id",
    "constraint_id",
    "constraint_content_hash",
    "previous_status",
    "status",
    "reason_code",
    "consecutive_breaches",
    "required_breaches",
    "consecutive_recoveries",
    "required_recoveries",
    "response_ladder",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "evaluation-decision-state.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "candidate_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segment_id": {"type": "string", "minLength": 1},
    "constraint_id": {"type": "string", "minLength": 1},
    "constraint_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_status": {"type": "string", "minLength": 1},
    "status": {"enum": ["admission_blocked", "breach_observed", "revert_required", "eligible", "recovery_observed", "recovery_review_required"]},
    "reason_code": {"type": "string", "minLength": 1},
    "consecutive_breaches": {"type": "integer", "minimum": 0},
    "required_breaches": {"type": "integer", "minimum": 1},
    "consecutive_recoveries": {"type": "integer", "minimum": 0},
    "required_recoveries": {"type": "integer", "minimum": 1},
    "response_ladder": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "last_verified_policy": {"type": ["object", "null"]},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
