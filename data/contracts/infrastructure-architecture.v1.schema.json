{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infrastructure-architecture.v1.schema.json",
  "title": "TokenEconomics proposed Azure infrastructure architecture",
  "type": "object",
  "required": ["schema_version", "route_id", "region", "baseline_revision", "classification", "resources", "safeguards"],
  "properties": {
    "schema_version": {"const": "infrastructure-architecture.v1"},
    "route_id": {"enum": ["foundry", "copilot_studio_byom", "foundry_work_iq"]},
    "region": {"type": "string", "minLength": 1},
    "baseline_revision": {"type": "string", "minLength": 1},
    "classification": {"const": "proposed"},
    "confirmed_profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource_id", "arm_resource_type", "service", "sku", "role", "material", "safeguards"],
        "properties": {
          "resource_id": {"type": "string", "minLength": 1},
          "arm_resource_type": {"type": "string", "minLength": 1},
          "service": {"type": "string", "minLength": 1},
          "sku": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "material": {"type": "boolean"},
          "safeguards": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "safeguards": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
