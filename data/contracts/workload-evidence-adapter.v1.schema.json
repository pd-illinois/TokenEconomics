{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only workload evidence adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "version", "kind", "network_execution", "maximum_tasks", "required_cost_families"],
  "properties": {
    "schema_version": {"const": "workload-evidence-adapter.v1"},
    "adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "version": {"type": "string", "minLength": 1},
    "kind": {"const": "immutable_run_store"},
    "network_execution": {"const": false},
    "maximum_tasks": {"type": "integer", "minimum": 1, "maximum": 10000},
    "required_cost_families": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["subscription", "included", "native_credit", "token_derived_credit", "direct_token", "resource", "retrieval", "tool", "evaluation", "observability"]}
    },
    "description": {"type": "string"},
    "live_evaluation": {"const": "unsupported"},
    "operational_dispatch": {"const": "unsupported"}
  }
}
