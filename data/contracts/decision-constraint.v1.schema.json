{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokeneconomics.local/contracts/decision-constraint.v1.schema.json",
  "title": "TokenEconomics decision constraint evidence",
  "type": "object",
  "required": [
    "schema_version",
    "constraint_id",
    "experiment_id",
    "experiment_revision",
    "arm_id",
    "candidate_id",
    "candidate_version",
    "candidate_content_hash",
    "observation_unit",
    "evaluated_at",
    "evidence_classification",
    "probability_model",
    "outcome",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": "decision-constraint.v1"},
    "constraint_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_revision": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "candidate_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_unit": {"const": "completed_task"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evidence_classification": {"enum": ["measured", "modeled", "simulated", "proposed", "blocked", "production_validated"]},
    "probability_model": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["eligible", "ineligible", "inconclusive"]},
    "expected_allocatable_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "segment_version",
          "sample_count",
          "accepted_count",
          "budget_breach_count",
          "budget_usd",
          "breach_tolerance",
          "minimum_samples",
          "confidence_level",
          "minimum_acceptance_lower_bound",
          "outcome",
          "reason_codes",
          "acceptance_evidence_hashes",
          "cost_evidence_hashes"
        ],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "segment_version": {"type": "string", "minLength": 1},
          "sample_count": {"type": "integer", "minimum": 0},
          "accepted_count": {"type": "integer", "minimum": 0},
          "budget_breach_count": {"type": "integer", "minimum": 0},
          "expected_allocatable_cost_usd": {"type": ["number", "null"], "minimum": 0},
          "budget_usd": {"type": "number", "exclusiveMinimum": 0},
          "breach_tolerance": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "minimum_samples": {"type": "integer", "minimum": 1},
          "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "minimum_acceptance_lower_bound": {"type": "number", "minimum": 0, "maximum": 1},
          "empirical_breach_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "breach_probability_upper_bound": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "acceptance_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "acceptance_wilson_lower_bound": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "outcome": {"enum": ["eligible", "ineligible", "inconclusive"]},
          "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "acceptance_evidence_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "cost_evidence_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
