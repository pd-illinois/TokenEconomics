# ── Azure OpenAI / Foundry ──
# Required: Your Azure OpenAI API key and endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── LLM Classifier (classifies task descriptions into model/pattern/complexity) ──
# Deployment name for the classifier (cheap/fast model recommended)
AZURE_OPENAI_CLASSIFIER_DEPLOYMENT=gpt-4.1-nano

# ── Tier 3 Estimator (LLM-assisted token estimation) ──
# Deployment name for Tier 3 (cheap/fast model recommended)
AZURE_OPENAI_TIER3_DEPLOYMENT=gpt-4.1-nano

# ── Optional: Override for specific components ──
# CLASSIFIER_API_KEY=         # Use a different key for classifier
# CLASSIFIER_ENDPOINT=        # Use a different endpoint for classifier
# CLASSIFIER_MODEL=           # Use a different model for classifier
# TIER3_API_KEY=              # Use a different key for Tier 3
# TIER3_BASE_URL=             # Use a different endpoint for Tier 3
# TIER3_MODEL=                # Use a different model for Tier 3

# ── Optional: Direct OpenAI (non-Azure) ──
# OPENAI_API_KEY=             # Falls back to this if no Azure vars set
