2').ConnectionString)), if(empty(parameters('policyReviewGitHubPrivateKeySecretUri')), createArray(), createArray(createObject('name', 'TOKENGOV_GITHUB_APP_PRIVATE_KEY', 'secretRef', 'tokengov-github-app-private-key'))))]",
