{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVPWeaver state",
  "type": "object",
  "required": ["product", "blocks"],
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "object",
      "required": ["name", "idea", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "idea": { "type": "string", "minLength": 1 },
        "status": { "enum": ["shaping", "building", "shipped"] },
        "tech_stack": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "title", "goal", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^B[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "status": { "enum": ["todo", "building", "in-review", "done", "reverted", "unverified", "baseline"] },
        "origin": { "enum": ["built", "adopted"] },
        "runner": { "enum": ["pytest", "vitest", "jest"] },
        "module": { "type": "string" },
        "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^B[0-9]+$" } },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": { "type": "array", "items": { "type": "string" } },
            "outputs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "acceptance_test": { "type": "string" },
        "contract_test": { "type": "string" },
        "checkpoint_tag": { "type": "string" },
        "decision": {
          "type": "object",
          "required": ["rationale", "pattern", "complexity", "provenance"],
          "additionalProperties": false,
          "properties": {
            "rationale": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "complexity": { "type": "string", "minLength": 1 },
            "provenance": {
              "type": "string",
              "pattern": "^(authored|generated|adapted-from:.+)$"
            }
          }
        }
      }
    }
  }
}
