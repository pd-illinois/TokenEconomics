# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Auth is Entra ID (az login), so NO API KEY is required or stored here.

# ---- REQUIRED for --live: model endpoint + deployments ----
# Foundry project or Azure OpenAI endpoint (include trailing slash):
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# gpt-5 / o-series reasoning models require a recent API version:
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Auth: use developer credentials (az login / VS Code) and skip a Conditional-Access-blocked
# service principal if AZURE_CLIENT_ID/SECRET happen to be set in your environment.
# Values: 'dev' (CLI/VSCode/etc.) or 'prod' (managed identity / env SP). Requires azure-identity>=1.23.
AZURE_TOKEN_CREDENTIALS=dev

# Two explicit chat deployments so OUR gateway can route (benchmark arm 1):
AZURE_DEPLOYMENT_CHEAP=gpt-cheap        # gpt-5-nano (weak-on-hard -> triggers the eval gate)
AZURE_DEPLOYMENT_PREMIUM=gpt-premium    # gpt-5 (strong on everything)

# Foundry Model Router deployment (benchmark arm 2 — Azure routes):
AZURE_DEPLOYMENT_ROUTER=<model-router-deployment-name>

# Judge model for the eval gate (can equal the premium deployment):
AZURE_DEPLOYMENT_JUDGE=<judge-deployment-name>

# ---- REAL PRICES (per 1K tokens) so cost accounting is accurate ----
# Defaults below are illustrative gpt-5-nano (cheap) / gpt-5 (premium) prices; verify on the
# Azure pricing page for your region and replace before trusting the dollar figures.
PRICE_CHEAP_INPUT=0.00005
PRICE_CHEAP_OUTPUT=0.0004
PRICE_PREMIUM_INPUT=0.00125
PRICE_PREMIUM_OUTPUT=0.01
# Router billed at the underlying model's price + an input markup (set if known):
PRICE_ROUTER_INPUT_MARKUP=0.0

# ---- OPTIONAL: full service wiring (leave blank to run these locally) ----
# Semantic cache with real embeddings (else local cosine is used):
AZURE_DEPLOYMENT_EMBEDDING=<text-embedding-3-small-deployment>

# Grounded RAG benchmark (rag/ingest.py and rag/bench_rag.py):
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX=books
RAG_TOP_K=12
RAG_EVALUATION_SAMPLE_RATE=1.0

# Studio-only deployed-agent batches (never the legacy direct lexical adapter).
# Read-only inventory resolves an exact live version when VERSION is empty.
# Measurement requires an unexpired, reviewed measurement object in Azure policy.
# There is no environment-variable bypass for policy or a guaranteed task spend cap.
# Version/model mismatches and missing hybrid configuration still block dispatch.
RAG_BATCH_PROJECT_ENDPOINT=https://ai-account-xbk6ickycmp22.services.ai.azure.com/api/projects/ai-project-tokeneconomics-te003
RAG_BATCH_AGENT_NAME=tokengov-books-rag-agent
RAG_BATCH_AGENT_VERSION=
# Optional LOCAL deployed-agent/evaluation identity pin. Use the subscription UUID
# of the intended cached `az login` account when other developer identities exist.
# Hosted runtimes reject this setting and continue to require managed identity.
TOKENGOV_RAG_AZURE_CLI_SUBSCRIPTION=
# Expected model comes from the selected immutable forecast, not a global override.
# EXISTING private metrics evidence destination. No keys/SAS in Studio configuration.
# Provision the container and narrowly scoped identity access separately.
# The runtime uses create-only writes; publication status is distinct from execution.
RAG_BATCH_EVIDENCE_ACCOUNT_URL=
RAG_BATCH_EVIDENCE_CONTAINER=

# App Configuration — hydrate the config knobs from Azure (else config.json):
AZURE_APPCONFIG_ENDPOINT=
# Optional LOCAL policy-read identity pin: subscription UUID for the cached az login
# account. Avoids other tenants in the developer credential chain or CLI default.
# Does not change az account set, grant permissions, publish policy or enable fallback.
# Leave unset in hosted environments so the runtime uses DefaultAzureCredential.
TOKENGOV_POLICY_AZURE_CLI_SUBSCRIPTION=

# Application Insights — export telemetry (else in-memory + jsonl only):
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Read-only Azure MCP evidence for Studio Plan.
# Local development starts this exact package over stdio. Production should leave this
# false and configure an Entra-protected Streamable HTTP endpoint instead.
TOKENECONOMICS_AZURE_MCP_ENABLED=false
AZURE_MCP_PACKAGE_VERSION=3.0.0-beta.41
# AZURE_MCP_ENDPOINT=https://<private-mcp-endpoint>/mcp
# AZURE_MCP_SCOPE=api://<mcp-app-id>/.default
# AZURE_MCP_SERVER_REVISION=<immutable-deployment-revision>

# ---- SAFETY: live runs cost real money ----
LIVE_MAX_REQUESTS=20          # hard cap on real calls per run
LIVE_WORKLOAD_REPEATS=3       # small repeats so a full run costs cents

# ---- REASONING MODELS (gpt-5 / o-series) ----
# gpt-5 spends hidden reasoning tokens; 'minimal' keeps short support answers fast + cheap
# and prevents empty responses. Leave BLANK for classic models (gpt-4o / gpt-4.1).
AZURE_REASONING_EFFORT=minimal
LIVE_MAX_COMPLETION_TOKENS=1024   # answer budget (must exceed reasoning + reply tokens)
LIVE_JUDGE_COMPLETION_TOKENS=512  # judge budget (returns a single 0..1 number)

# ---- Studio read-only lifecycle authorization (disabled unless explicitly enabled) ----
# Native local Studio keeps all delivery options. The Docker image defaults this
# release-scope flag to true: non-Foundry routes are visible but cannot be forecast.
# This is not execution authorization and does not change Azure policy authority.
# TOKENECONOMICS_FOUNDRY_ONLY=false
# These scopes do NOT grant policy publication or dispatch a live workload.
# Local operator opt-ins are separate; never enable them on untrusted shared ingress.
TOKENGOV_EVALUATION_ALLOW_LOCAL=false
TOKENGOV_OPERATIONAL_ALLOW_LOCAL=false
# Production requires authenticated Container Apps ingress with spoofed principal
# headers stripped by the ingress. Keep evaluation and operational allowlists separate.
# TOKENGOV_LIFECYCLE_AUTHENTICATED_INGRESS=container_apps
# TOKENGOV_EVALUATION_ALLOWED_PRINCIPAL=<evaluation-principal-object-id>
# TOKENGOV_OPERATIONAL_ALLOWED_PRINCIPAL=<operational-principal-object-id>
# Runtime identities still read Azure policy; protected policy publication remains
# on the existing GitHub review/OIDC workflow with its own authorization.
