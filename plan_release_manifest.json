    "path": "FutureTokenPredictor",
    "include": ["pyproject.toml", "src/future_token_predictor", "data"],
    "exclude": [".env", ".venv", ".weave", "tests", "scripts", "kanban.md", "mindmap.md"],
    "test_command": "python scripts/run_tests.py --all --expect pass"
  }
}
